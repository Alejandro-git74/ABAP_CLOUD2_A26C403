@Metadata.layer: #CORE
@UI: { headerInfo: { typeName:            'Incident',
                     typeNamePlural:      'Incidents',
                     title:               { type: #STANDARD,
                                            label: 'Incidents',
                                            value: 'IncidentID' } }, 
       presentationVariant: [{ sortOrder: [{ by: 'IncidentId',
                                             direction: #ASC } ],                                          
       visualizations: [{ type: #AS_LINEITEM }]
                                                         }] 
                                                          }                      
annotate entity ZC_ZDT_INCT_AHJ
    with 
{
  @EndUserText.label: 'IncUUID'
  @UI.facet: [{ id:            'Incident',
                purpose:       #STANDARD,
                type:          #IDENTIFICATION_REFERENCE,
                label:         'Incident',
                position:      10 },
              { id:            'History',
                purpose:       #STANDARD,
                type:          #LINEITEM_REFERENCE,
                label:         'History',
                position:      20,
                targetElement: '_History'}]   
  @UI: {lineItem: [{ position: 10, 
                     importance: #HIGH,
                     label: 'IncUUID'},
                   { type: #FOR_ACTION,
                     dataAction: 'changeStatus',
                     label: 'Change Status',
                     position: 10 }],
  identification: [{ position: 10,
                     label: 'IncUUID' },
                   { type: #FOR_ACTION,
                     dataAction: 'changeStatus',
                     label: 'Change Status',
                     position: 10 }],                               
  selectionField: [{ position: 10 }]} 
  @UI.hidden: true                            
  IncUuid;
    
  @UI: {lineItem: [{ position: 20, importance: #MEDIUM }],
  identification: [{ position: 20  }],
  selectionField: [{ position: 20 }]}
  IncidentId;
        
  @UI: {lineItem: [{ position: 30, importance: #LOW }],
  identification: [{ position: 30  }] }    
  Title;
     
  @UI: {lineItem: [{ position: 40, importance: #LOW }],
  identification: [{ position: 40  }],
  selectionField: [{ position: 40 }]}  
  Description;
        
  @Consumption.valueHelpDefinition: [ { entity.name: 'zdd_status_vh_ahj',
                                        entity.element: 'StatusCode',
                                        useForValidation: true   } ]   
  @UI: {lineItem: [{ position: 50, importance: #LOW }],
  identification: [{ position: 50  }],
  selectionField: [{ position: 50 }]}   
  Status;
    
  @Consumption.valueHelpDefinition: [ { entity.name: 'zdd_priority_vh_ahj',
                                        entity.element: 'PriorityCode',
                                        useForValidation: true } ]
  @UI: {lineItem: [{ position: 60, importance: #LOW }],
  identification: [{ position: 60  }],
  selectionField: [{ position: 60 }]}  
  Priority;
      
  @UI: {lineItem: [{ position: 70, importance: #LOW }],
  identification: [{ position: 70  }],
  selectionField: [{ position: 70 }]}    
  CreationDate;
      
  @UI: {lineItem: [{ position: 80, importance: #LOW }],
  identification: [{ position: 80  }],
  selectionField: [{ position: 80 }]}    
  ChangedDate;
  
  @UI.hidden: true
  LocalCreatedBy;
     
  @UI.hidden: true
  LocalCreatedAt;
    
  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;
 
  @UI.hidden: true
  LastChangedAt;
      
   /* Associations */
   @UI.hidden: true    
   _History;   

}